FROM node:22-bookworm-slim AS javascript
FROM python:3.11-slim-bookworm
COPY --from=javascript /usr/local/bin/node /usr/local/bin/node
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DROXIONCLIPS_VERIFY_VIDEO_TOOLS=1 DROXIONCLIPS_YOUTUBE_ENABLED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY projects/d6x8-clips/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY projects/d6x8-clips/ ./
RUN mkdir -p /tmp/droxionclips-beta && chmod 700 /tmp/droxionclips-beta
EXPOSE 10000
CMD ["sh","-c","exec uvicorn cloud_app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]

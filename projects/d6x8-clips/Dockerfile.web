FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates nodejs && rm -rf /var/lib/apt/lists/*
COPY projects/d6x8-clips/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY projects/d6x8-clips/ ./
RUN mkdir -p /tmp/droxionclips-beta && chmod 700 /tmp/droxionclips-beta
EXPOSE 10000
CMD ["sh","-c","exec uvicorn cloud_app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
